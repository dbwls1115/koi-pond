{
  "rules": {
    "stats": {
      ".read": true,
      "eaten": {
        ".write": true,
        ".validate": "newData.isNumber() && ((!data.exists() && newData.val() >= 0 && newData.val() <= 200) || (data.exists() && newData.val() >= data.val() && newData.val() <= data.val() + 200))"
      }
    },
    "presence": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "!newData.exists() || newData.val() === true"
      }
    },
    "events": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['k','t'])",
        "k": {
          ".validate": "newData.isString() && newData.val().matches(/^(catfish|albino|eel|blue)$/)"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}